# =============================================================================
# kilo-me — environment variables
#
# As of the auth.json refactor, secrets live in a separate file at
#   $XDG_DATA_HOME/kilo/auth.json   (typically ~/.local/share/kilo/auth.json)
# rather than in environment variables. This file is now mostly for
# *non-secret* paths and toggles, plus dev-mode overrides.
#
# Copy to .env for project-local development. For the global install
# (`bash install.sh`), put credentials in auth.json instead — see
# README.md → "Credentials and auth.json" for details.
# =============================================================================

# ─── Credentials (PREFER auth.json; only set these for project-local dev) ────
# OPENROUTER_API_KEY=sk-or-v1-...
# BP_REPO_PATH=/Users/you/code/kilo-best-practices
# BP_REMOTE_BRANCH=main
# BP_AUTO_MERGE=0

# ─── Override the auth.json location ─────────────────────────────────────────
# AUTH_FILE=/some/explicit/path/auth.json
# Or shift the whole XDG data home:
# XDG_DATA_HOME=/custom/data   # auth.json lives at $XDG_DATA_HOME/kilo/auth.json

# ─── Storage paths (default to ~/.config/kilo/) ──────────────────────────────
# Leave these unset to use the global defaults; override only if you want
# project-scoped state.
# MEMORY_DB_PATH=~/.config/kilo/memory.sqlite
# CHROMA_PATH=~/.config/kilo/chroma
# CHROMA_COLLECTION=decisions
# EMBED_MODEL=all-MiniLM-L6-v2
# MODELS_CACHE_PATH=~/.config/kilo/models.curated.json
#
# Standard XDG override:
# XDG_CONFIG_HOME=/custom/config   # then code/agents live at $XDG_CONFIG_HOME/kilo/

# ─── OpenRouter catalog tuning (non-sensitive) ───────────────────────────────
# Empty = fetch ALL models. Set to "programming" to filter to coding models
# only. Comma-separated list of categories also accepted.
# OPENROUTER_CATEGORY=
# How long the catalog stays fresh before auto-refreshing (seconds; 24h default)
# MODELS_TTL_SECONDS=86400

# ─── Best-practices sync (for `make sync-bp`) ────────────────────────────────
# Override the source dir for promoted patterns
# BP_DECISIONS_DIR=~/.config/kilo/decisions

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
