{
  "$schema": "https://app.kilo.ai/config.json",
  // ---------------------------------------------------------------------------
  // kilo-me — GLOBAL Kilo Code config
  //
  // This file is a TEMPLATE. The installer (`install.sh`) renders it with
  // `__KILO_HOME__` replaced by the absolute path of $XDG_CONFIG_HOME/kilo
  // (typically ~/.config/kilo) and writes the result to that location, where
  // Kilo Code reads it for ALL projects on this machine.
  //
  // After install, edit ~/.config/kilo/kilo.jsonc directly for personal
  // tweaks — re-running install.sh will OVERWRITE it (a backup is kept first).
  // ---------------------------------------------------------------------------

  // OpenRouter is a built-in provider in Kilo — no `provider.openrouter` block
  // is needed. Authenticate once with `kilo auth login`, which writes the
  // provider object into ~/.local/share/kilo/auth.json. Reference models as
  // "openrouter/<id>" or "openai/<id>" for direct OpenAI routes.
  //
  // Local cluster providers (Tailscale-routed Ollama). Phase 2 splits into
  // two providers so hard-tier agents can land on the RTX and soft-tier on
  // the Mac mini without a router. Phase 3 replaces this with a single
  // "local" provider pointed at the Pi router that decides dynamically.
  //
  //   "local":      {"type":"openai-compat", "key":"...", "base_url":"http://macmini:11434/v1"}
  //   "local-hard": {"type":"openai-compat", "key":"...", "base_url":"http://rtx:11434/v1"}
  //
  // Reference models as "local/<tag>" or "local-hard/<tag>".
  //
  // DEFAULT MODEL is the hard-tier coder so any project boots local-first on
  // the RTX. Rule 06 walks the chain → soft tier → cloud on hard failure.
  "model": "local-hard/qwen3-coder:14b-instruct-q8_0",

  // ---------------------------------------------------------------------------
  // Agents — built-in slots (architect, code, debug) now point at the LOCAL
  // cluster (-lo lineup). Cloud lineups (-ch, -us) remain reachable by their
  // full name (@architect-ch, @coder-us, etc) and serve as Rule 06 fallbacks.
  // The `ask` slot stays on free OpenRouter models since local doesn't help
  // a "free Q&A" workload.
  // ---------------------------------------------------------------------------
  "agent": {
    // ── Built-in slots — LOCAL-first, hard tier ─────────────────────────────
    "architect": {
      "model": "local-hard/devstral:22b-q5_K_M",
      "temperature": 0.1,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "code": {
      "model": "local-hard/qwen3-coder:14b-instruct-q8_0",
      "temperature": 0.3,
      "permission": { "edit": "allow", "bash": "allow" }
    },
    "debug": {
      "model": "local-hard/deepseek-r1-distill-qwen:14b-q5_K_M",
      "temperature": 0.2,
      "permission": { "edit": "deny", "bash": "allow" }
    },
    // The ask agent prompt (.kilo/agents/ask.md) calls
    // openrouter-models.top_free_models() at task start and routes through
    // whatever free model wins. The slug below is a sentinel default for
    // bootstrap before that tool is reachable.
    "ask": {
      "model": "openrouter/openrouter/free",
      "temperature": 0.4,
      "permission": { "edit": "deny", "bash": "deny" }
    },

    // ── Chinese-default lineup ──────────────────────────────────────────────
    "architect-ch": {
      "model": "openrouter/deepseek/deepseek-v4-pro",
      "temperature": 0.1,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "coder-ch": {
      "model": "openrouter/moonshotai/kimi-k2.6",
      "temperature": 0.3,
      "permission": { "edit": "allow", "bash": "allow" }
    },
    "debugger-ch": {
      "model": "openrouter/z-ai/glm-5.1",
      "temperature": 0.2,
      "permission": { "edit": "deny", "bash": "allow" }
    },
    "memory-curator-ch": {
      "model": "openrouter/qwen/qwen3.6-plus",
      "temperature": 0.4,
      "permission": { "edit": "ask", "bash": "deny" }
    },
    "cheap-fallback-ch": {
      "model": "openrouter/deepseek/deepseek-v3.2",
      "temperature": 0.3,
      "permission": { "edit": "allow", "bash": "ask" }
    },
    "accountant-ch": {
      "model": "openrouter/deepseek/deepseek-v3.2",
      "temperature": 0.1,
      "permission": { "edit": "ask", "bash": "allow" }
    },

    // ── Western frontier lineup ─────────────────────────────────────────────
    "architect-us": {
      "model": "openrouter/anthropic/claude-opus-4.7",
      "temperature": 0.1,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "coder-us": {
      "model": "openai/gpt-5.4",
      "temperature": 0.3,
      "permission": { "edit": "allow", "bash": "allow" }
    },
    "debugger-us": {
      "model": "openrouter/anthropic/claude-sonnet-4.6",
      "temperature": 0.2,
      "permission": { "edit": "deny", "bash": "allow" }
    },
    "memory-curator-us": {
      "model": "openrouter/anthropic/claude-haiku-4.5",
      "temperature": 0.4,
      "permission": { "edit": "ask", "bash": "deny" }
    },
    "cheap-fallback-us": {
      "model": "openrouter/x-ai/grok-4.1-fast",
      "temperature": 0.3,
      "permission": { "edit": "allow", "bash": "ask" }
    },
    "accountant-us": {
      "model": "openrouter/anthropic/claude-haiku-4.5",
      "temperature": 0.1,
      "permission": { "edit": "ask", "bash": "allow" }
    },

    // ── Local cluster lineup (Tailscale → Ollama workers) ──────────────────
    // Phase 2 routing (manual, until Phase 3 router lands):
    //   Hard tier → "local-hard" provider (RTX 4070 Ti Super)
    //   Soft tier → "local"      provider (Mac mini M4)
    // Rule 07 documents the model menu and tool-calling discipline.
    "architect-lo": {
      "model": "local-hard/devstral:22b-q5_K_M",
      "temperature": 0.1,
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "coder-lo": {
      "model": "local-hard/qwen3-coder:14b-instruct-q8_0",
      "temperature": 0.3,
      "permission": { "edit": "allow", "bash": "allow" }
    },
    "debugger-lo": {
      "model": "local-hard/deepseek-r1-distill-qwen:14b-q5_K_M",
      "temperature": 0.2,
      "permission": { "edit": "deny", "bash": "allow" }
    },
    "memory-curator-lo": {
      "model": "local/llama3.3:8b-instruct-q5_K_M",
      "temperature": 0.4,
      "permission": { "edit": "ask", "bash": "deny" }
    },
    "cheap-fallback-lo": {
      "model": "local/gemma3:4b",
      "temperature": 0.3,
      "permission": { "edit": "allow", "bash": "ask" }
    },
    "accountant-lo": {
      "model": "local/llama3.3:8b-instruct-q5_K_M",
      "temperature": 0.1,
      "permission": { "edit": "ask", "bash": "allow" }
    }
  },

  // ---------------------------------------------------------------------------
  // MCP servers — invoked via `uv run`, which reads each script's PEP 723
  // metadata block and materializes deps in uv's cache. No system Python
  // pollution. Absolute paths are filled in by install.sh.
  // ---------------------------------------------------------------------------
  "mcp": {
    "sqlite-memory": {
      "type": "local",
      "command": ["uv", "run", "--script", "__KILO_HOME__/mcp_servers/sqlite_memory/server.py"],
      "environment": {
        "MEMORY_DB_PATH": "__KILO_HOME__/memory.sqlite"
      },
      "timeout": 30000,
      "enabled": true
    },
    "openrouter-models": {
      "type": "local",
      "command": ["uv", "run", "--script", "__KILO_HOME__/mcp_servers/openrouter_models/server.py"],
      "environment": {
        "MODELS_CACHE_PATH": "__KILO_HOME__/models.curated.json"
      },
      "timeout": 60000,
      "enabled": true
    },
    "mermaid-vector": {
      "type": "local",
      "command": ["uv", "run", "--script", "__KILO_HOME__/mcp_servers/mermaid_vector/server.py"],
      "environment": {
        "CHROMA_PATH": "__KILO_HOME__/chroma"
      },
      "timeout": 120000,
      "enabled": true
    },
    "graph-memory": {
      "type": "local",
      "command": ["uv", "run", "--script", "__KILO_HOME__/mcp_servers/graph_memory/server.py"],
      "environment": {
        "GRAPH_DB_PATH": "__KILO_HOME__/graph.kuzu"
      },
      "timeout": 60000,
      "enabled": true
    },
    "task-enricher": {
      "type": "local",
      "command": ["uv", "run", "--script", "__KILO_HOME__/mcp_servers/task_enricher/server.py"],
      "environment": {
        "TASK_ENRICH_MODEL": "gpt-5.4"
      },
      "timeout": 60000,
      "enabled": true
    },
    "cluster-health": {
      "type": "local",
      "command": ["uv", "run", "--script", "__KILO_HOME__/mcp_servers/cluster_health/server.py"],
      "environment": {},
      "timeout": 15000,
      "enabled": true
    }
  }
}
